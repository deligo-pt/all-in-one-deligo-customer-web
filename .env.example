# ─────────────────────────────────────────────────────────────────────────────
# DeliGo customer web — environment
#
# Copy to `.env.local` for development. On Vercel these go in
# Settings → Environment Variables (Production, Preview and Development).
# `verify:structure` checks this file against what the code actually reads and
# against `.env.local`, so a variable that exists is a variable listed here.
#
# Every NEXT_PUBLIC_ value is compiled into the browser bundle and is readable
# by anyone. That is correct for all of these — they are keys restricted by
# domain, not secrets — which is exactly why the restrictions in DEPLOYMENT.md
# matter.
# ─────────────────────────────────────────────────────────────────────────────

# The backend. No trailing slash. Test: https://api-test-food.deligo.pt/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api-test-food.deligo.pt/api/v1

# This deployment's own origin — metadataBase, canonical URLs, hreflang. On
# Production it must be the real public URL, not a vercel.app preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps JavaScript API: the address form's geocoding and pin, and the
# store details map. MUST be referrer-restricted to this deployment's domains,
# or maps answer RefererNotAllowedMapError (measured, 16 Sep 2026).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google sign-in (Identity Services). The OAuth client's "Authorised JavaScript
# origins" must list this deployment's domains.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Facebook sign-in. The app's "App domains" must list this deployment's domains.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Firebase Cloud Messaging — order and delivery notifications.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Ride, hotel and parcel have no backend (D-6). Unset means hidden in
# production and visible in development, which is what you want. Set "true"
# only on a preview deployment that is meant to show them.
NEXT_PUBLIC_SHOW_UNBUILT_VERTICALS=

# ── Local tooling. Never set these on Vercel. ────────────────────────────────

# `pnpm analyze` sets this to open the interactive bundle report.
ANALYZE=

# Where a verification build writes, so it never contends with the dev server's
# `.next/`. `pnpm build:check` sets it; on Vercel it would send the build
# somewhere Vercel does not look.
NEXT_DIST_DIR=

# Not read by the app: a Figma personal token for design sync, used by tooling
# only. Never committed, never needed by a deployment.
FIGMA_TOKEN=
