# DeliGo customer web — environment reference
#
# Copy to `.env.local` and fill in. Every variable the app reads is listed here.
# If you add a new `process.env.*` lookup, add it here in the same change —
# `pnpm verify:structure` fails the build if you don't, because the next person
# to deploy has no other way to learn the variable exists.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time. That
# means two things: they are public (never put a secret behind that prefix), and
# changing one requires a rebuild, not just a restart.

# ─── Backend ─────────────────────────────────────────────────────────────────
# Required from Phase 15. No default — the app cannot talk to anything without it.
NEXT_PUBLIC_API_BASE_URL="https://api-test-food.deligo.pt/api/v1"

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Required from Phase 16. Used by address entry, the order map, ride pickup and
# destination, and the distance-matrix route.
#
# This key is public by design — it ships in the client bundle. Secrecy is not
# the protection; an HTTP-referrer restriction on the GCP key is. Set that
# before any deploy (Phase 24).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Firebase Cloud Messaging (push notifications) ───────────────────────────
# All seven are read from Phase 15: after a sign-in the browser asks for push
# permission and registers its token (`/auth/update-fcm-token`), and
# `/firebase-messaging-sw.js` is generated from these. If any is missing no
# token is requested and the device silently never receives a notification.
# There is no error — which is what makes this worth spelling out.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ─── Social login ────────────────────────────────────────────────────────────
# Required from Phase 15. Both IDs are public identifiers — the browser SDKs need
# them and they ship in the bundle by design. Neither is a secret. The Facebook
# *app secret* is a secret, belongs on the server only, and must never appear
# in this file.
#
# Each provider needs setup outside this file, and without it the customer gets
# an error rather than nothing:
#
#   Google    — this environment's exact origin (scheme, host, port) must be
#               under Authorized JavaScript origins on the OAuth client, and the
#               client ID must be in the backend's allowlist. Miss the first and
#               the button never renders; miss the second and every sign-in
#               returns INVALID_SOCIAL_TOKEN.
#               Use the **Web application** client ID, not Android/iOS.
#   Facebook  — this domain must be in App Domains and Valid OAuth Redirect
#               URIs, `email` must be on the login use case, and while the app
#               is in Development mode only accounts under App roles can log in.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=""
NEXT_PUBLIC_FACEBOOK_APP_ID=""

# ─── Site ────────────────────────────────────────────────────────────────────
# Required from Phase 2. The app's own public origin, used as `metadataBase` so
# the hreflang alternates (`/en`, `/pt`) and every later canonical URL resolve to
# absolute addresses. Wrong here means a search engine is told the Portuguese and
# English pages live somewhere they do not, which is worse than not telling it.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Feature flags ───────────────────────────────────────────────────────────
# Decision D-6. Five of the six verticals in the design have no backend behind
# them; their pages exist and are reachable by URL, but navigation hides them
# unless this is "true". Unset means: shown in development, hidden in production
# — the safe state is the default, because a flag whose unsafe state is the
# default is a flag that ships in its unsafe state.
NEXT_PUBLIC_SHOW_UNBUILT_VERTICALS=""

# ─── Build tooling ───────────────────────────────────────────────────────────
# Not read by the app. `ANALYZE=true` makes `next build` open the bundle report;
# `pnpm analyze` sets it for you. Used to check routes against the 180 KB
# first-load budget in Plan.md §6.
ANALYZE=""

# Not read by the app. `pnpm build:check` sets this so a verification build
# writes to .next-build/ instead of the .next/ the dev server owns.
NEXT_DIST_DIR=""

# Figma read access for the design passes (Plan.md §1.1).
# Not read by the app: it is a tooling credential, used from the shell to
# measure and export frames, and it must never take a NEXT_PUBLIC_ prefix or
# reach a bundle. The value lives in .env.local and is never committed. It is
# account-wide and carries write scopes this project must not use; rotate when
# the rebuild ships.
FIGMA_TOKEN=
